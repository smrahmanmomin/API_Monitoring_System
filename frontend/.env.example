# Base path/URL of the backend API as seen by the browser.
# Default "/api" uses the Vite dev/preview proxy (see vite.config.ts).
VITE_API_BASE_URL=/api
# Where the Vite proxy forwards /api requests.
BACKEND_URL=http://localhost:4000
# Dashboard auto-refresh interval in milliseconds.
VITE_POLL_INTERVAL_MS=10000
