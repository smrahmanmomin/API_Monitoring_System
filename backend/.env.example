# ─────────────────────────────────────────────────────────────
# Backend configuration. Copy to backend/.env and adjust.
# Placeholder values only — never commit real secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL from docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://apimonitor:apimonitor_dev_password@localhost:5433/apimonitor?schema=public
# Used only by the automated integration tests (database created by docker/postgres/init-test-db.sql)
TEST_DATABASE_URL=postgresql://apimonitor:apimonitor_dev_password@localhost:5433/apimonitor_test?schema=public

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Request limits
MAX_BATCH_SIZE=500
REQUEST_BODY_LIMIT=256kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
MONITOR_RATE_LIMIT_MAX=60

# ── Monitoring rules ─────────────────────────────────────────
LATENCY_THRESHOLD_MS=3000
# Latency severity becomes HIGH at threshold x multiplier
LATENCY_HIGH_MULTIPLIER=2
# Per-API overrides (JSON). Example:
# API_THRESHOLDS_JSON={"ReportingAPI":{"latencyThresholdMs":8000},"PatientDataAPI":{"expectedMinRecords":1}}
API_THRESHOLDS_JSON=
# Grouped alert severity is raised one level when its occurrence count reaches this value (0 = off)
ESCALATION_OCCURRENCES=5

# ── LLM (any OpenAI-compatible Chat Completions API) ─────────
# Default: Groq free tier — create a key at https://console.groq.com/keys
# Alternatives (change all three values):
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash
#   Ollama : LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1  LLM_API_KEY=ollama
#   OpenAI : LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# Leave LLM_API_KEY empty to run with the deterministic fallback alert generator only.
LLM_ENABLED=true
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
# gpt-oss is a reasoning model: keep reasoning short so JSON fits the output budget.
# Leave empty for non-reasoning models (most Ollama/Gemini/OpenAI chat models).
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=1200
# Free tiers cap tokens per minute (Groq: 8,000 TPM), so generate one alert at a time and
# retry rate-limited jobs after a delay instead of giving up.
LLM_CONCURRENCY=1
LLM_RATE_LIMIT_RETRY_MS=20000
LLM_RATE_LIMIT_ATTEMPTS=3

# ── Optional e-mail anomaly reports ──────────────────────────
# Defaults target the Mailpit container (inbox UI: http://localhost:8025).
# Leave SMTP_HOST or ALERT_EMAIL_TO empty to disable e-mail.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=API Monitor <alerts@apimonitor.local>
ALERT_EMAIL_TO=oncall@example.com
EMAIL_MIN_SEVERITY=HIGH
DASHBOARD_URL=http://localhost:5173
